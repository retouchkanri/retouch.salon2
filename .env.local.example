# ============================================================
# Retouch メンバーズサイト - 環境変数サンプル
# 実値は .env.local に書く。コミットしないこと。
# ============================================================

# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# === アップロードファイル・バックアップの保存先（VPS のディスク。任意） ===
# 未設定ならプロジェクト直下の storage/ と backups/ を使う。DB にはファイルのパスだけを保存する。
# FILE_STORAGE_DIR=C:\retouch-data\storage
# BACKUP_DIR=C:\retouch-data\backups

# === Stripe ===
# ダッシュボード > 開発者 > APIキー / Webhook
STRIPE_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
# Webhook 署名シークレット（必須。検証に失敗すると全イベントが破棄される）
# Webhook エンドポイント：{NEXT_PUBLIC_SITE_URL}/api/stripe/webhook
# 受け取るべきイベント：
#   checkout.session.completed
#   invoice.payment_succeeded
#   invoice.payment_failed
#   customer.subscription.created
#   customer.subscription.updated
#   customer.subscription.deleted
#   payment_intent.succeeded
#   payment_intent.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# === サイト URL（Stripe success_url / cancel_url / メール内リンクに使用） ===
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Retouchメンバーズサイト

# === 通知メール ===
# 送信方式: "smtp"（本番で使用）/ "resend" / "audit"（記録のみ・送信しない）
NOTIFY_TRANSPORT=smtp
#
# ★ 迷惑メール（Spam）対策 ＝ 送信元ドメインの認証（SPF / DKIM / DMARC）。
#   個人の Gmail（例: xxxx@gmail.com）から会員向けの定型メールを送ると、
#   ブランドのドメインと差出人ドメインが一致せず Gmail 等で Spam 判定されやすい。
#   → 解決策: 自社ドメイン（retouch-members.com）の認証済みメールボックスから送る。
#     既存の問い合わせ先 info@retouch-members.com は Xserver（sv####.xserver.jp）
#     で運用されており SPF/DKIM が設定済みのため、これを SMTP 送信に使うのが最善。
#
# 例（Xserver の retouch-members.com メールボックスを使う）:
SMTP_HOST=svXXXX.xserver.jp
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@retouch-members.com
SMTP_PASS=（メールボックスのパスワード）
# 差出人。SMTP_USER と同一ドメインに揃えること（DKIM/DMARC アライメントのため）。
MAIL_FROM=info@retouch-members.com
MAIL_FROM_NAME=Retouchメンバーズ事務局
# 会員に表示する問い合わせ先 / スタッフ通知の宛先（カンマ区切り）
CONTACT_EMAIL=info@retouch-members.com
CONTACT_RECIPIENTS=info@retouch-members.com
#
# Resend を使う場合のみ:
# NOTIFY_TRANSPORT=resend
# RESEND_API_KEY=re_xxxxx
#
# 一斉配信のSMTP接続・レート制御（既定値で通常は変更不要）。
#   1通ごとに再ログインすると Gmail 等は "454-4.7.0 Too many login attempts" で
#   ブロックする（2026-08 の配信障害の原因）。接続プールで1ログイン=多数通に集約する。
# SMTP_MAX_CONNECTIONS=1   # 同時接続数（増やしてもログインが増えるだけなので 1 を推奨）
# SMTP_MAX_MESSAGES=90     # 1接続あたりの送信数（Gmail は約100通/セッションで切断）
# SMTP_RATE_DELTA=1000     # レート計測窓（ミリ秒）
# SMTP_RATE_LIMIT=1        # 窓あたりの送信数。Gmail=1通/秒。Xserver は 2500/1 で約0.4通/秒
#
# ※ 送信量の上限（プロバイダ側）: 無料 Gmail ≈ 500通/日（24h ローリング）。
#    Xserver = 1,500通/時・15,000通/日。1000名超の一斉配信は Xserver か Resend 推奨。
#
# 一斉配信の自主的な日次上限（既定値で通常は変更不要）。
#   Gmail の実際の上限ぎりぎりまで送ると Google の不正利用検知でアカウント停止の
#   リスクが上がるため、余裕をもって手前で自動的に止め、残りは翌日以降に送る。
#   SMTP_HOST に "gmail" を含む場合は既定 400通/24h、それ以外（Xserver等）は
#   既定 5000通/24h。Xserver に切り替えた後も明示的に上げたい場合のみ設定する:
# NEWSLETTER_DAILY_CAP=5000
#
# ※ Vercel 本番では同じ変数を Project Settings > Environment Variables に登録すること。
# ※ DMARC 未設定の場合は retouch-members.com の DNS に DMARC レコードの追加も推奨。

# === 定期実行（cron）認証 ===
# /api/cron/newsletters（予約配信・送り残しの自動再開）と
# /api/cron/db-backup（管理画面「DBバックアップ」の自動バックアップ）の認証キー。
# ★ Vercel の Project Settings > Environment Variables に CRON_SECRET を登録すると、
#   Vercel Cron が Authorization: Bearer <CRON_SECRET> を付けて呼び出すようになる。
#   未設定だと環境によっては cron が 401 で空振りし続け、送り残しが永久に再開されない
#   （2026-07-12 の配信が3週間止まっていた原因の最有力候補）。
# CRON_SECRET=（ランダムな長い文字列）

# === AIチャットボット（OpenAI + RAG） ===
# OpenAI APIキー（sk-... で始まる）。
# 優先順位: 管理画面(/admin/chatbot)でDBに保存したキー > この環境変数。
# Vercel 本番では Project Settings > Environment Variables に
# OPENAI_API_KEY を登録すること（.env.local はローカル開発専用）。
OPENAI_API_KEY=sk-xxxxx

# === 寄付：銀行振込の振込先口座 ===
# 公開の単発寄付ページ（/donate）で「銀行振込」を選んだ際に表示し、案内メールにも記載する。
# 未設定の項目は「（未設定）」と表示される。Vercel 本番にも同じ変数を登録すること。
BANK_TRANSFER_BANK_NAME=○○銀行
BANK_TRANSFER_BRANCH=○○支店
BANK_TRANSFER_ACCOUNT_TYPE=普通
BANK_TRANSFER_ACCOUNT_NUMBER=1234567
BANK_TRANSFER_ACCOUNT_HOLDER=シャ）リタッチ
BANK_TRANSFER_NOTE=お振込の際は寄付者様のお名前をご入力ください。

# === 会員セルフサービス（マイページからの申し込み）の可否 ===
# true  : 会員自身がマイページから「一口支援の追加・寄付・見学(予約)・馬の面会」を申し込める。
# false/未設定 : 申し込みボタンを非表示にし、対応するAPIも403で拒否（運営が代行する運用）。
# ※ NEXT_PUBLIC_* はビルド時に埋め込まれるため、本番反映には Vercel の環境変数設定＋再デプロイが必須。
NEXT_PUBLIC_MEMBER_SELF_SERVICE=true

# === 特別チーム会員（リタポ）の新規受付の可否 ===
# true  : マイページから特別チーム会員（馬ごと月額¥1,000）の新規申し込みを受け付ける。
# false/未設定 : 新規受付を停止（既存会員はそのまま）。
# ※ NEXT_PUBLIC_MEMBER_SELF_SERVICE=true と両方 true の場合のみ申し込みボタンが表示される。
NEXT_PUBLIC_SPECIAL_TEAM_SIGNUPS=true

# === 会員種別（A/B/C 有料会員）への会員自身の入会・変更の可否 ===
# 既定で有効（無料会員が有料会員種別へ入会できるようにするため）。
# 停止する場合のみ false を設定する。
# NEXT_PUBLIC_MEMBER_PLAN_SELF_SERVICE=false
